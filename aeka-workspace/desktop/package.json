{
  "name": "aeka-scribe-desktop",
  "productName": "Aeka Scribe",
  "version": "0.7.0",
  "description": "Aeka Scribe for Windows: dictation and meeting notes",
  "author": "Aeka Advisors India LLP",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:ui": "node build-shared.mjs && node ../node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "package:win": "node scripts/package-win.cjs --win zip nsis --x64 --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.aekaadvisors.scribe",
    "productName": "Aeka Scribe",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "services/**/*",
      "ui-dist/**/*",
      "package.json",
      "generated/**/*",
      "overlay-preload.cjs",
      "overlay.html"
    ],
    "extraResources": [
      {
        "from": "windows",
        "to": "windows"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Aeka-Scribe-${version}-Windows-${arch}.${ext}",
      "icon": "assets/aeka-scribe-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "../public/desktop-guide.html",
        "to": "START-HERE.html"
      },
      {
        "from": "admin",
        "to": "Admin"
      }
    ],
    "copyright": "Copyright (c) 2026 Aeka Advisors India LLP"
  }
}
