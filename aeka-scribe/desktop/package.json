{
  "name": "flow-desktop",
  "productName": "Flow Desktop",
  "version": "0.5.0",
  "description": "Independent Windows dictation and meeting workspace",
  "author": "Flow Workspace",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:ui": "node build-shared.mjs && node ../node_modules/vite/bin/vite.js build --config vite.config.mjs",
    "package:win": "node scripts/package-win.cjs --win zip nsis --x64 --publish never",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.flowworkspace.desktop",
    "productName": "Flow Desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "services/**/*",
      "ui-dist/**/*",
      "package.json",
      "generated/**/*",
      "overlay-preload.cjs",
      "overlay.html"
    ],
    "extraResources": [
      {
        "from": "windows",
        "to": "windows"
      }
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false,
      "artifactName": "Flow-Desktop-${version}-Windows-${arch}.${ext}",
      "icon": "assets/flow-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "../public/desktop-guide.html",
        "to": "START-HERE.html"
      },
      {
        "from": "admin",
        "to": "Admin"
      }
    ]
  }
}
